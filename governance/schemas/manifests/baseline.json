          "nullable": false,
          "type": "unknown"
        },
        "is_active": {
          "nullable": false,
          "type": "unknown"
        }
      },
      "grain": "one row per country_code"
    },
    "dim_users": {
      "contract_version": "1.0",
      "fields": {
        "first_event_at": {
          "nullable": false,
          "type": "unknown"
        },
