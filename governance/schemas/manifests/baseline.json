          "accepted_values": [
            "none",
            "within_batch",
            "cross_batch_replay"
          ],
          "nullable": false,
          "type": "unknown"
        },
        "event_id": {
          "nullable": false,
          "type": "unknown"
        },
        "is_accepted": {
          "nullable": false,
          "type": "unknown"
        },
        "is_duplicate_extra": {
          "nullable": false,
          "type": "unknown"
        },
        "is_within_batch_duplicate": {
          "nullable": false,
          "type": "unknown"
        },
        "rejection_reason": {
          "accepted_values": [
            "accepted",
            "missing_user_id",
            "invalid_country_code",
            "future_dated",
            "duplicate_extra"
          ],
          "nullable": false,
          "type": "unknown"
        },
        "within_batch_duplicate_rank": {
          "nullable": false,
          "type": "unknown"
        }
      },
      "grain": "one row per staged physical event record with classification flags"
    },
    "int_rejected_events": {
      "contract_version": "1.0",
      "fields": {
        "rejection_reason": {
          "nullable": false,
          "type": "unknown"
        }
